{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    ".nvmrc",
    ".npmrc",
    "packages/config/tsconfig.base.json"
  ],
  "globalPassThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "NEXT_PUBLIC_CX_API_URL",
        "CX_API_INTERNAL_URL",
        "NEXT_PUBLIC_APP_URL"
      ]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
