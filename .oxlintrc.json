{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "unicorn", "oxc", "react"],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.next/**",
    "**/dist/**",
    "**/.expo/**",
    "**/src-tauri/target/**",
    "packages/db/src/database.types.ts"
  ],
  "rules": {
    "complexity": ["warn", 20],
    "max-depth": ["warn", 4],
    "max-lines": [
      "warn",
      {
        "max": 500,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-lines-per-function": [
      "warn",
      {
        "max": 120,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-params": ["warn", 4],
    "no-var": "warn",
    "typescript/no-import-type-side-effects": "error",
    "typescript/consistent-type-imports": "error"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/e2e/**"],
      "rules": {
        "max-lines-per-function": "off",
        "max-lines": "off"
      }
    },
    {
      "files": [
        "apps/*/app/**/*.tsx",
        "apps/web/components/**/*.tsx",
        "apps/*/src/app/**/*.tsx"
      ],
      "rules": {
        "max-lines-per-function": [
          "warn",
          {
            "max": 300,
            "skipBlankLines": true,
            "skipComments": true
          }
        ],
        "complexity": ["warn", 35]
      }
    }
  ]
}
