{
  "name": "@cxedu/api-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "auth:schema": "tsx src/scripts/printAuthSchema.ts"
  },
  "dependencies": {
    "@cxedu/core": "workspace:*",
    "@hono/node-server": "2.1.5",
    "@hono/node-ws": "1.3.1",
    "better-auth": "1.7.12",
    "hono": "4.13.13",
    "jose": "6.2.13",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cxedu/config": "workspace:*",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1"
  }
}
