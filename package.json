{
  "name": "cxedu",
  "private": true,
  "description": "CXedu — hệ điều hành giữ chân học viên cho trung tâm cờ vua & năng khiếu (Dương Sinh)",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "api:dev": "pnpm --filter @cxedu/api-server dev",
    "db:migrate": "pnpm --filter @cxedu/database migrate",
    "db:reset": "pnpm --filter @cxedu/database reset",
    "db:test": "pnpm --filter @cxedu/database test",
    "db:types": "supabase gen types typescript --db-url \"${DATABASE_URL:-postgres://postgres:postgres@127.0.0.1:5432/cxedu}\" --schema public > packages/db/src/database.types.ts && oxfmt packages/db/src/database.types.ts",
    "platform:up": "docker compose -f infra/docker-compose.yml up -d --build",
    "platform:down": "docker compose -f infra/docker-compose.yml down",
    "e2e": "pnpm --filter @cxedu/web e2e",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "supabase": "2.121.0",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
